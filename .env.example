# Postgres. Supabase gives you this string under Project Settings -> Database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pitcrew

# Stripe. The platform account; connected accounts are created per mechanic.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Platform economics. Every one of these is a business decision, not a
# constant — they live in env so changing the model does not need a deploy of
# new logic. See docs/ECONOMICS.md for what each one does to margin.
PLATFORM_RATE_FLOOR_CENTS=6500
PLATFORM_FEE_BPS=1000
PARTS_HANDLING_BPS=350
